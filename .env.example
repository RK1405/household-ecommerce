# ---------- App ----------
PORT=3000
# Public base URL used for absolute links (Open Graph tags, emails, share links)
BASE_URL=http://localhost:3000
NODE_ENV=development
# Demo mode: shows demo credentials on login pages and NEVER sends real email (writes to storage/outbox)
DEMO_MODE=true
# Secret for signing the httpOnly session cookie (JWT). CHANGE THIS in any shared environment.
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=72

# ---------- Data layer ----------
# json (default, files under /data) | mysql (documents + files stored in MySQL, see src/db/mysqlStore.js) | salesforce (future)
DATA_PROVIDER=json

# ---------- MySQL (used when DATA_PROVIDER=mysql) ----------
# Either one connection URL (mysql://user:pass@host:4000/db) or the individual values below.
MYSQL_URL=
# Set true for cloud databases that require TLS (TiDB Cloud, Aiven, PlanetScale...)
MYSQL_SSL=false
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=homehaat
MYSQL_PASSWORD=
MYSQL_DATABASE=homehaat

# ---------- Salesforce (future) ----------
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_USERNAME=
SF_PASSWORD=

# ---------- Payments ----------
# dummy (built-in simulator) | razorpay (stub in src/services/payments/razorpay.provider.js)
PAYMENT_PROVIDER=dummy
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Secret used by the dummy gateway to sign payments (mirrors Razorpay's HMAC signature)
DUMMY_GATEWAY_SECRET=dummy_gateway_secret

# ---------- Email (SMTP) ----------
# Values here are defaults; the admin "Email settings" page overrides them (stored in data/settings.json).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HomeHaat <no-reply@homehaat.example>"
ADMIN_EMAIL=admin@demo.com

# ---------- Maps ----------
# Google Maps JavaScript API key. Leave empty to use the Leaflet + OpenStreetMap fallback.
GOOGLE_MAPS_API_KEY=
